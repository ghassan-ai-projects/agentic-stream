{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-stream.local/schemas/situation-model-v0.schema.json",
  "title": "Agentic Stream V0 Situation Model",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "entity_type",
    "inputs",
    "windows",
    "facts",
    "states",
    "episode_types",
    "cognition_triggers"
  ],
  "properties": {
    "$schema": {"type": "string", "maxLength": 256},
    "schema_version": {"const": "0.1"},
    "id": {"$ref": "#/$defs/identifier"},
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maxLength": 32
    },
    "entity_type": {"$ref": "#/$defs/identifier"},
    "inputs": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {"$ref": "#/$defs/identifier"},
      "additionalProperties": {"$ref": "#/$defs/input"}
    },
    "windows": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {"$ref": "#/$defs/identifier"},
      "additionalProperties": {"$ref": "#/$defs/window"}
    },
    "facts": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 128,
      "propertyNames": {"$ref": "#/$defs/identifier"},
      "additionalProperties": {"$ref": "#/$defs/fact"}
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/state"}
    },
    "episode_types": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {"$ref": "#/$defs/identifier"},
      "additionalProperties": {"$ref": "#/$defs/episodeType"}
    },
    "cognition_triggers": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/trigger"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "duration": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_type", "value_type"],
      "properties": {
        "event_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
        },
        "value_type": {
          "enum": ["number", "string", "none"]
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"value_type": {"const": "number"}},
            "required": ["value_type"]
          },
          "then": {"required": ["unit"]}
        },
        {
          "if": {
            "properties": {"value_type": {"enum": ["string", "none"]}},
            "required": ["value_type"]
          },
          "then": {"not": {"required": ["unit"]}}
        }
      ]
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration", "lateness_allowance"],
      "properties": {
        "duration": {"$ref": "#/$defs/duration"},
        "lateness_allowance": {"$ref": "#/$defs/duration"}
      }
    },
    "fact": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["aggregate", "input", "window"],
          "properties": {
            "aggregate": {"enum": ["avg", "max"]},
            "input": {"$ref": "#/$defs/identifier"},
            "window": {"$ref": "#/$defs/identifier"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["latest"],
          "properties": {
            "latest": {"$ref": "#/$defs/identifier"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["absent", "timeout"],
          "properties": {
            "absent": {"$ref": "#/$defs/identifier"},
            "timeout": {"$ref": "#/$defs/duration"}
          }
        }
      ]
    },
    "state": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "priority", "default"],
          "properties": {
            "id": {"$ref": "#/$defs/identifier"},
            "priority": {"type": "integer", "minimum": 0, "maximum": 10000},
            "default": {"const": true}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "priority", "enter"],
          "properties": {
            "id": {"$ref": "#/$defs/identifier"},
            "priority": {"type": "integer", "minimum": 0, "maximum": 10000},
            "enter": {"$ref": "#/$defs/expression"},
            "stay": {"$ref": "#/$defs/expression"}
          }
        }
      ]
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "episode_type"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "from": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "to": {"$ref": "#/$defs/identifier"},
        "episode_type": {"$ref": "#/$defs/identifier"}
      }
    },
    "episodeType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "instruction",
        "output_schema",
        "evidence_reference_pointer"
      ],
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "output_schema": {
          "type": "object",
          "minProperties": 1
        },
        "evidence_reference_pointer": {
          "type": "string",
          "pattern": "^(/[A-Za-z0-9_-]+)+$",
          "maxLength": 256
        }
      }
    },
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["all"],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {"$ref": "#/$defs/expression"}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any"],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {"$ref": "#/$defs/expression"}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["not"],
          "properties": {
            "not": {"$ref": "#/$defs/expression"}
          }
        },
        {"$ref": "#/$defs/comparison"}
      ]
    },
    "comparison": {
      "oneOf": [
        {"$ref": "#/$defs/gte"},
        {"$ref": "#/$defs/gt"},
        {"$ref": "#/$defs/lte"},
        {"$ref": "#/$defs/lt"},
        {"$ref": "#/$defs/eq"},
        {"$ref": "#/$defs/neq"}
      ]
    },
    "gte": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gte"],
      "properties": {"gte": {"$ref": "#/$defs/binaryOperands"}}
    },
    "gt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gt"],
      "properties": {"gt": {"$ref": "#/$defs/binaryOperands"}}
    },
    "lte": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lte"],
      "properties": {"lte": {"$ref": "#/$defs/binaryOperands"}}
    },
    "lt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lt"],
      "properties": {"lt": {"$ref": "#/$defs/binaryOperands"}}
    },
    "eq": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eq"],
      "properties": {"eq": {"$ref": "#/$defs/binaryOperands"}}
    },
    "neq": {
      "type": "object",
      "additionalProperties": false,
      "required": ["neq"],
      "properties": {"neq": {"$ref": "#/$defs/binaryOperands"}}
    },
    "binaryOperands": {
      "type": "array",
      "prefixItems": [
        {"$ref": "#/$defs/operand"},
        {"$ref": "#/$defs/operand"}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "operand": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["fact"],
          "properties": {"fact": {"$ref": "#/$defs/identifier"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["number"],
          "properties": {"number": {"type": "number"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["string"],
          "properties": {
            "string": {"type": "string", "maxLength": 256}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["boolean"],
          "properties": {"boolean": {"type": "boolean"}}
        }
      ]
    }
  }
}
