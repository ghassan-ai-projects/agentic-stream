{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-stream:example:maintenance-decision:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "situationId",
    "situationVersion",
    "decisionType",
    "facts",
    "inferences",
    "alternatives",
    "uncertainty",
    "validUntil",
    "intents"
  ],
  "properties": {
    "situationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "situationVersion": {
      "type": "integer",
      "minimum": 1
    },
    "decisionType": {
      "enum": ["diagnosis", "no_action", "needs_human", "needs_evidence"]
    },
    "facts": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/evidencedStatement"
      }
    },
    "inferences": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/inference"
      }
    },
    "alternatives": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/inference"
      }
    },
    "uncertainty": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "requestedEvidence": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "validUntil": {
      "type": "string",
      "format": "date-time"
    },
    "intents": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/intent"
      }
    }
  },
  "$defs": {
    "evidenceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "evidencedStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "evidenceIds"],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidenceId"
          }
        }
      }
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "confidence", "evidenceIds"],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidenceIds": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidenceId"
          }
        }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "parameters", "evidenceIds", "expiresAt"],
      "properties": {
        "type": {
          "enum": ["create_maintenance_ticket", "recommend_operating_limit"]
        },
        "parameters": {
          "type": "object"
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidenceId"
          }
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
