{
  "protocol_version": 1,
  "safe_stops": {
    "led-01": {"operation": "safe_stop", "expires_after_ms": 1000},
    "fan-01": {"operation": "safe_stop", "expires_after_ms": 1000}
  },
  "routes": {
    "set_indicator": {
      "operation": "set_led",
      "target": "led-01",
      "target_bindings": {"zone-01": "led-01"},
      "selector_field": "state",
      "expires_after_ms": 60000,
      "presets": {
        "off": {"brightness_permille": 0, "pattern": "off"},
        "watch": {"brightness_permille": 500, "pattern": "slow_blink"},
        "alert": {"brightness_permille": 1000, "pattern": "solid"}
      }
    },
    "select_thermal_mode": {
      "operation": "set_pwm_lease",
      "target": "fan-01",
      "target_bindings": {"zone-01": "fan-01"},
      "selector_field": "mode",
      "expires_after_ms": 20000,
      "presets": {
        "hold": {"duty_permille": 0, "lease_ms": 5000},
        "bounded_cooling": {"duty_permille": 450, "lease_ms": 5000}
      },
      "bounds": {
        "duty_permille": {"max": 600},
        "lease_ms": {"max": 10000}
      }
    }
  }
}
