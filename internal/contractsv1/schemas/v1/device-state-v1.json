{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:situation-runtime:schema:device-state:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["message_type", "protocol_version", "device_id", "boot_id", "firmware_digest", "capability_digest", "safe_state"],
  "properties": {
    "message_type": {"const": "state"},
    "protocol_version": {"type": "integer", "minimum": 1, "maximum": 255},
    "device_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "boot_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "firmware_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "capability_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "safe_state": {"type": "boolean"},
    "current_output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": {"type": "string", "maxLength": 256},
        "operation": {"type": "string", "maxLength": 256},
        "value": {"type": "number"},
        "energized": {"type": "boolean"}
      }
    },
    "dedup_ledger": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "persistent": {"type": "boolean"},
        "size": {"type": "integer", "minimum": 0}
      }
    }
  }
}
