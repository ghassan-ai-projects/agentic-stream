{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:situation-runtime:schema:snapshot:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["situation_id", "situation_version", "situation_type", "tenant_id", "entity", "phase", "severity", "completeness", "event_horizon", "spec_digest", "facts"],
  "properties": {
    "situation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "situation_version": {"type": "integer", "minimum": 1},
    "situation_type": {"type": "string", "minLength": 1, "maxLength": 256},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {"type": "string", "minLength": 1, "maxLength": 128},
        "id": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "partition_id": {"type": "integer", "minimum": 0},
    "phase": {"type": "string", "minLength": 1, "maxLength": 128},
    "previous_phase": {"type": "string", "maxLength": 128},
    "severity": {"type": "number"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "uncertainty": {"type": "number", "minimum": 0, "maximum": 1},
    "completeness": {"enum": ["provisional", "on_time", "corrected", "final_by_policy", "uncertain"]},
    "event_horizon": {"type": "string", "format": "date-time"},
    "watermark": {"type": "string", "format": "date-time"},
    "spec_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "facts": {"type": "object"},
    "evidence": {"type": "array", "maxItems": 4096, "items": {"type": "string", "minLength": 1, "maxLength": 256}}
  }
}
