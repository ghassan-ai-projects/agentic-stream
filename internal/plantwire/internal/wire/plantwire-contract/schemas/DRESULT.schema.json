{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:plant-wire:v1:DRESULT",
  "title": "DRESULT",
  "description": "Command result as the device reports it. Self-reported: it may disagree with reality.",
  "type": "object",
  "required": [
    "type",
    "protocol_version",
    "session_id",
    "seq",
    "lane",
    "command_id",
    "reported_outcome",
    "boot_id"
  ],
  "properties": {
    "type": {
      "const": "DRESULT"
    },
    "protocol_version": {
      "type": "integer",
      "minimum": 1
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "lane": {
      "const": "control"
    },
    "command_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "reported_outcome": {
      "enum": [
        "succeeded",
        "failed",
        "unknown"
      ]
    },
    "boot_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    }
  }
}
