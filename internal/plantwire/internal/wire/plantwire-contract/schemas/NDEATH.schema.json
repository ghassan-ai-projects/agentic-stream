{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:plant-wire:v1:NDEATH",
  "title": "NDEATH",
  "description": "Node death: graceful end. On socket loss the host synthesises it; a stale bd_seq is ignored.",
  "type": "object",
  "required": [
    "type",
    "protocol_version",
    "session_id",
    "seq",
    "lane",
    "bd_seq",
    "reason"
  ],
  "properties": {
    "type": {
      "const": "NDEATH"
    },
    "protocol_version": {
      "type": "integer",
      "minimum": 1
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "lane": {
      "const": "control"
    },
    "bd_seq": {
      "type": "integer",
      "minimum": 0
    },
    "reason": {
      "enum": [
        "shutdown",
        "connection_lost"
      ]
    }
  }
}
