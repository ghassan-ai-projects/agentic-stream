{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:plant-wire:v1:NCMD",
  "title": "NCMD",
  "description": "Node command: rebirth republishes every birth before further data.",
  "type": "object",
  "required": [
    "type",
    "protocol_version",
    "session_id",
    "seq",
    "lane",
    "command"
  ],
  "properties": {
    "type": {
      "const": "NCMD"
    },
    "protocol_version": {
      "type": "integer",
      "minimum": 1
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "lane": {
      "const": "control"
    },
    "command": {
      "enum": [
        "rebirth"
      ]
    }
  }
}
