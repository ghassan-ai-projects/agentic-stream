{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:plant-wire:v1:BOARD",
  "title": "BOARD",
  "description": "A board mapping: how one board type implements kinds, command and reading, in raw board values (SPEC section 15). Every member name is an id; a schema cannot say that, so a validator checks it with the other rules of section 15. board_digest is computed from the file, which must not carry it. A kind the mapping does not name passes through unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "board_type",
    "kinds"
  ],
  "properties": {
    "board_type": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "kinds": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "commands",
          "metrics"
        ],
        "properties": {
          "commands": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "raw"
              ],
              "properties": {
                "raw": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                },
                "args": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "value": {
                        "type": [
                          "number",
                          "integer",
                          "boolean",
                          "string"
                        ],
                        "maxLength": 64
                      },
                      "from": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                      },
                      "scale": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "description": "raw = semantic x scale, in both directions (a reading is the raw value divided by it)."
                      }
                    },
                    "oneOf": [
                      {
                        "required": [
                          "value"
                        ]
                      },
                      {
                        "required": [
                          "from"
                        ]
                      }
                    ],
                    "if": {
                      "required": [
                        "value"
                      ]
                    },
                    "then": {
                      "not": {
                        "required": [
                          "scale"
                        ]
                      }
                    },
                    "description": "One raw argument: a fixed value, or a semantic argument (from) times scale (default 1). A string value for a raw name in raw_enums is one of its words."
                  }
                },
                "by": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                },
                "table": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": {
                      "type": [
                        "number",
                        "integer",
                        "boolean",
                        "string"
                      ],
                      "maxLength": 64
                    }
                  }
                },
                "lease": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "arg",
                    "ms"
                  ],
                  "properties": {
                    "arg": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                    },
                    "ms": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 86400000
                    }
                  },
                  "description": "The board's lease: the raw argument that carries it and its fixed duration. The command's effect lapses after ms unless renewed."
                }
              },
              "if": {
                "required": [
                  "by"
                ]
              },
              "then": {
                "required": [
                  "table"
                ]
              },
              "else": {
                "not": {
                  "required": [
                    "table"
                  ]
                }
              },
              "description": "A kind command to one raw command. by names the semantic argument whose word selects a table row of raw arguments."
            }
          },
          "metrics": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "raw"
              ],
              "properties": {
                "raw": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                },
                "scale": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "raw = semantic x scale, in both directions (a reading is the raw value divided by it)."
                },
                "table": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                  },
                  "description": "Raw word (one of raw_enums) to the kind's word."
                }
              },
              "not": {
                "required": [
                  "scale",
                  "table"
                ]
              },
              "description": "A kind metric from one raw reading: copied, divided by scale, or translated by table."
            }
          },
          "raw_enums": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              }
            },
            "description": "The words of a raw enumerated value, in the order of their integer codes (a twin's code is the index)."
          }
        }
      }
    },
    "board_digest": {
      "not": {},
      "description": "Forbidden in a board mapping: the digest is computed from the file."
    }
  }
}
