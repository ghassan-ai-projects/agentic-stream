# --- Go build artifacts ---
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (uncomment if you vendor)
# vendor/

# Go workspace file
go.work
go.work.sum

# --- Environment & secrets ---
.env
.env.*
!.env.example

# --- Build output ---
bin/
dist/
build/

# --- IDE / Editor ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db

# --- Project-specific (customize per project) ---
# /tmp/
# /var/

# --- Runtime artifacts ---
*.db
*.db-journal
*.db-wal
*.db-shm
